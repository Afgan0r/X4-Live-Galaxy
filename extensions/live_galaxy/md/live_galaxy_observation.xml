<?xml version="1.0" encoding="utf-8"?>
<mdscript name="live_galaxy_observation">
  <!--
    Runtime event syntax, cadence, and save-sensitive detection remain pending
    a disposable X4 probe. This cue remains telemetry-only: it declares no
    actions, reports, acknowledgements, or game-state effect path.
  -->
  <cues>
    <cue name="live_galaxy_root" instantiate="true">
      <conditions>
        <event_game_started />
      </conditions>
      <cues>
        <cue name="live_galaxy_observation" checkinterval="30s">
          <actions>
            <raise_lua_event name="'live_galaxy_observation'" param="'telemetry_tick'" />
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
