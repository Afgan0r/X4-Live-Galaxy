<?xml version="1.0" encoding="utf-8"?>
<mdscript name="live_galaxy_observation">
  <!--
    MD supplies one-shot lifecycle boundaries. The Lua global update callback
    owns bounded collection and transport progress; there is no periodic MD pump.
  -->
  <cues>
    <cue name="live_galaxy_game_start">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart" />
      </conditions>
      <actions>
        <raise_lua_event name="'live_galaxy_observation'" param="'telemetry_game_start'" />
      </actions>
    </cue>
    <cue name="live_galaxy_game_loaded">
      <conditions>
        <event_game_loaded />
      </conditions>
      <actions>
        <raise_lua_event name="'live_galaxy_observation'" param="'telemetry_game_loaded'" />
      </actions>
    </cue>
  </cues>
</mdscript>
