<?xml version="1.0" encoding="utf-8"?>
<mdscript name="live_galaxy_observation">
  <!--
    X4 owns this bounded callback seam. Lua owns collection and co-operative
    progress; this cue declares no mutation or support-API dependency.
  -->
  <cues>
    <cue name="live_galaxy_game_start">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart" />
      </conditions>
      <cues>
        <cue name="live_galaxy_observation" instantiate="true" checkinterval="1s">
          <actions>
            <raise_lua_event name="'live_galaxy_observation'" param="'telemetry_tick'" />
          </actions>
        </cue>
      </cues>
    </cue>
    <cue name="live_galaxy_game_loaded">
      <conditions>
        <event_game_loaded />
      </conditions>
      <cues>
        <cue name="live_galaxy_loaded_observation" instantiate="true" checkinterval="1s">
          <actions>
            <raise_lua_event name="'live_galaxy_observation'" param="'telemetry_game_loaded'" />
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
