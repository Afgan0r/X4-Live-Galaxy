{
  "schema_version": "runtime-evidence.v1",
  "evidence_classification": "local-contract-only",
  "stage_order": ["execution", "contract", "effect"],
  "verdicts": {
    "execution": ["pass", "fail", "not_run"],
    "contract": ["pass", "fail", "not_run"],
    "effect": ["pass", "mismatch", "fail", "not_run"]
  },
  "completeness": ["complete", "partial", "unknown", "not_applicable"],
  "seta_states": ["active", "inactive", "unknown", "not_applicable"],
  "digest_algorithm": "sha256",
  "digest_hex_length": 64,
  "required_fields": [
    "schema_version",
    "evidence_classification",
    "game_version",
    "mod_list",
    "scenario_id",
    "run_id",
    "candidate_id",
    "stage_id",
    "candidate_source",
    "expected_result",
    "actual_result",
    "completeness",
    "elapsed_real_ms",
    "elapsed_game_ms",
    "seta_state",
    "failure_point",
    "prior_dossier_id",
    "prior_dossier_digest",
    "build_id",
    "build_profile_digest",
    "execution_verdict",
    "contract_verdict",
    "effect_verdict",
    "work_units",
    "observation_count",
    "digest_algorithm",
    "canonical_digest_payload",
    "record_digest"
  ],
  "bounds": {
    "max_candidates": 16,
    "max_steps": 3,
    "max_work_units_per_step": 64,
    "max_candidate_rows": 3,
    "max_observations_per_step": 32,
    "max_mods": 64,
    "max_string_bytes": 256,
    "max_row_bytes": 4096,
    "max_total_bytes": 65536,
    "max_output_rows": 48
  }
}
