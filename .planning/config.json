    "routing_tier_defaults": {
      "heavy": "high",
      "standard": "medium",
      "light": "high"
    }
  },
  "dynamic_routing": {
    "enabled": true,
    "tier_models": {
      "heavy": "gpt-5.6-sol",
      "standard": "gpt-5.6-sol",
      "light": "gpt-5.6-luna"
    },
    "escalate_on_failure": false,
    "max_escalations": 0
  },
  "fast_mode": {
    "enabled": true,
    "routing_tier_defaults": {
      "light": false,
      "standard": false,
      "heavy": false
    }
  },
