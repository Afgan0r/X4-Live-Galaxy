  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "git": {
    "branching_strategy": "milestone",
    "create_tag": true,
    "phase_branch_template": "codex/phase-{phase}-{slug}",
