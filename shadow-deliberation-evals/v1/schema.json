{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-galaxy/shadow-deliberation/v1",
  "type": "object",
  "required": ["schema_version", "capability", "priority", "horizon", "supporting_fact_ids", "trade_offs", "explanation", "command_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "schema-v1"},
    "capability": {"type": "string"},
    "priority": {"type": "integer", "minimum": 1, "maximum": 3},
    "horizon": {"type": "string"},
    "supporting_fact_ids": {"type": "array", "minItems": 1},
    "trade_offs": {"type": "array"},
    "explanation": {"type": "string"},
    "command_id": {"type": "string"}
  }
}
